# PHP Auth Application - Environment Configuration
# 
# Copy this file to .env and update with your actual values
# .env is in .gitignore and should never be committed
#
# Usage:
#   1. cp .env.example .env
#   2. Update .env with your credentials
#   3. Load in your application (see bootstrap.php)

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE_NAME=php_auth

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
# APP_ENV controls debugging and logging behavior
# Values: development, staging, production
# - development: verbose logging, debug output enabled
# - staging: minimal logging, errors only
# - production: no debug logging, errors only (no sensitive data)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# =====================================================
# EMAIL CONFIGURATION
# =====================================================
MAIL_FROM=noreply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# =====================================================
# RECAPTCHA CONFIGURATION
# =====================================================
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# =====================================================
# SESSION CONFIGURATION
# =====================================================
SESSION_LIFETIME=3600
SESSION_SECURE=false
SESSION_DOMAIN=localhost

# =====================================================
# SECURITY
# =====================================================
ACCOUNT_LOCKOUT_ATTEMPTS=4
ACCOUNT_LOCKOUT_DURATION=86400

# =====================================================
# CORS
# =====================================================
ALLOWED_ORIGINS=http://localhost:5173,https://example.com
